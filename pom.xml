<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>de.sharpsharp</groupId>
  <artifactId>katas</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Katas</name>
  <description>Sechs Katas mit derselben Werkzeugkiste: Java 17, JUnit 4, Hamcrest, Mockito, ApprovalTests, Cucumber, JaCoCo.
    Jede Kata ist ein eigener Ordner; mvn -q verify läuft dort oder hier für alle.</description>

  <modules>
    <module>gildedrose</module>
  </modules>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <junit.version>4.13.2</junit.version>
    <hamcrest.version>3.0</hamcrest.version>
    <mockito.version>5.23.0</mockito.version>
    <approvaltests.version>24.22.0</approvaltests.version>
    <cucumber.version>7.34.8</cucumber.version>
    <!-- Filled by JaCoCo with its agent -->
    <argLine></argLine>
  </properties>

  <dependencies>
    <dependency>
      <!-- Hamcrest 3 must come before JUnit, which drags in the old hamcrest-core 1.3 -->
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>${hamcrest.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.hamcrest</groupId>
          <artifactId>hamcrest-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Golden Master: Approvals.verifyAll writes *.received.txt; approved, it becomes *.approved.txt -->
      <groupId>com.approvaltests</groupId>
      <artifactId>approvaltests</artifactId>
      <version>${approvaltests.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- Akzeptanztests in Gherkin: Feature-Dateien unter src/test/resources/features, Runner RunCucumberTest -->
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.hamcrest</groupId>
          <artifactId>hamcrest-core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <!-- Stellt ${org.mockito:mockito-core:jar} bereit, damit Mockito als Agent startet statt sich selbst anzuhängen -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Testklassen heißen nach dem Gegenstand (AnAgedBrie, TheHandOfRagnaros), nicht *Test. -->
          <includes>
            <include>**/*.java</include>
          </includes>
          <!-- @{argLine} ist der JaCoCo-Agent; Mockito als zweiter Agent, damit mvn -q verify still bleibt -->
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
        </configuration>
      </plugin>
      <plugin>
        <!-- Coverage report, no gate: mvn verify writes target/site/jacoco/index.html and jacoco.csv.
             ../scripts/unabgedeckt.sh lists the lines the tests do not reach.
             append=false: jeder Lauf misst neu, ein gelöschter Test hinterlässt keine Abdeckung. -->
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
