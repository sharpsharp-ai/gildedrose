{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "edit": "allow",
    "bash": {
      "*": "deny",
      "mvn *": "allow",
      "mvn *skipTests*": "deny",
      "mvn *maven.test.skip*": "deny",
      "java .opencode/skills/clean-code-report/CleanCodeReport.java*": "allow",
      "scripts/unabgedeckt.sh*": "allow",
      "./scripts/unabgedeckt.sh*": "allow",
      "bash scripts/unabgedeckt.sh*": "allow",
      "sh scripts/unabgedeckt.sh*": "allow",
      "scripts/approve.sh*": "allow",
      "./scripts/approve.sh*": "allow",
      "bash scripts/approve.sh*": "allow",
      "sh scripts/approve.sh*": "allow",
      "scripts/regeln.sh*": "allow",
      "./scripts/regeln.sh*": "allow",
      "bash scripts/regeln.sh*": "allow",
      "sh scripts/regeln.sh*": "allow",
      "scripts/schritt.sh*": "allow",
      "./scripts/schritt.sh*": "allow",
      "bash scripts/schritt.sh*": "allow",
      "sh scripts/schritt.sh*": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "mkdir *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow"
    }
  },
  "agent": {
    "test-autor": {
      "description": "Schreibt Tests unter src/test: Approval, Characterization, Spec. Ändert keinen Produktivcode.",
      "mode": "primary",
      "steps": 60,
      "permission": {
        "edit": { "*": "deny", "src/test/java/*": "allow" }
      }
    },
    "refactorer": {
      "description": "Baut Produktivcode unter src/main in kleinen, grünen Schritten um. Ändert keine Tests, committet nur über scripts/schritt.sh.",
      "mode": "primary",
      "steps": 80,
      "permission": {
        "edit": { "*": "deny", "src/main/java/*": "allow" },
        "bash": {
          "scripts/approve.sh*": "deny",
          "./scripts/approve.sh*": "deny",
          "bash scripts/approve.sh*": "deny",
          "sh scripts/approve.sh*": "deny"
        }
      }
    }
  }
}
